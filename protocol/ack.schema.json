{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mathewstars/Gridzilla/protocol/ack.schema.json",
  "title": "Gridzilla ack v1",
  "type": "object",
  "required": [
    "v",
    "device",
    "path",
    "seq",
    "status",
    "reason",
    "applied",
    "soc",
    "grid_kw",
    "ts"
  ],
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "device": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "path": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "seq": {
      "type": [
        "integer",
        "null"
      ]
    },
    "status": {
      "enum": [
        "applied",
        "partial",
        "refused",
        "reverted"
      ]
    },
    "reason": {
      "enum": [
        null,
        "min_soc",
        "owner_limit",
        "stale_seq",
        "bad_sig",
        "out_of_scope",
        "expired",
        "bad_mode",
        "heartbeat_lost",
        "window_end",
        "opt_out"
      ]
    },
    "applied": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "import_max_kw": {
          "type": [
            "number",
            "null"
          ]
        },
        "export_max_kw": {
          "type": [
            "number",
            "null"
          ]
        },
        "export_min_kw": {
          "type": [
            "number",
            "null"
          ]
        },
        "charge_max_kw": {
          "type": [
            "number",
            "null"
          ]
        },
        "discharge_max_kw": {
          "type": [
            "number",
            "null"
          ]
        },
        "target_soc": {
          "type": [
            "number",
            "null"
          ]
        },
        "max_soc_by": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "soc": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "grid_kw": {
      "type": "number"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "curtailed_kwh": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    }
  }
}
