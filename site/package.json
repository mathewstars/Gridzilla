{
  "name": "gridzilla-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && VITE_SITE_ORIGIN=https://gridzilla.victronlab.sk/static/site vite build",
    "build:vercel": "VITE_SITE_ORIGIN=https://gridzilla-two.vercel.app vite build --base / --outDir dist-vercel --emptyOutDir",
    "og": "node og/render.mjs",
    "typecheck": "tsc -b",
    "preview": "vite preview --port 5181 --strictPort",
    "qa": "node qa/run.mjs",
    "qa:setup": "playwright-core install webkit",
    "shots": "node qa/console-shots.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "motion": "^11.11.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "playwright-core": "^1.48.2",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
