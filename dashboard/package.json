{
  "name": "gridzilla-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "qa": "node qa/run.mjs",
    "pitch:dev": "vite --port 5175 --strictPort --base /",
    "pitch:preview": "vite build --base / --outDir node_modules/.pitch-dist --emptyOutDir && vite preview --base / --outDir node_modules/.pitch-dist --port 4175 --strictPort",
    "pitch:pdf": "node qa/pitch-pdf.mjs",
    "pitch:qa": "node qa/pitch.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.1.0",
    "@phosphor-icons/react": "^2.1.7",
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "motion": "^11.11.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "playwright-core": "^1.48.2",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
