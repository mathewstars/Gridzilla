# copy to platform/.env (git-ignored) and fill in. run.sh sources it.
GZ_BROKER=127.0.0.1:1883
# HiveMQ Cloud (TLS on 8883):
#GZ_BROKER=xxxxxxxx.s1.eu.hivemq.cloud:8883
#GZ_MQTT_TLS=1
#GZ_MQTT_USER=gridzilla-platform
#GZ_MQTT_PASS=
GZ_PORT=8080
# LLM advisor: ALWAYS through the gateway on :9000, never the model server directly
GZ_LLM_URL=http://100.115.45.86:9000/v1
GZ_LLM_MODEL=DeepSeek-V4.1-Flash
GZ_LLM_KEY=
# operator key for the board's buttons (send signals, autopilot, heartbeat...): empty = no login; set it, then open /login?key=... once
GZ_OPERATOR_KEY=
